{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Benchmarks run directly through Node's type stripping and are never compiled.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false
  },
  "include": ["**/*.ts"]
}
