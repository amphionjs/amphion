{
  "name": "@amphion/benchmarks",
  "private": true,
  "description": "Micro-benchmarks (mitata) and HTTP load benchmarks (autocannon) for Amphion.",
  "type": "module",
  "scripts": {
    "bench": "node --conditions=amphion-source micro/run.ts",
    "bench:http": "node --conditions=amphion-source http/hello.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amphion/core": "workspace:^"
  },
  "devDependencies": {
    "@types/autocannon": "catalog:",
    "autocannon": "catalog:",
    "mitata": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
